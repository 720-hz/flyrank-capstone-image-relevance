# Google AI Studio key, free tier, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model ids (Gemini Flash free tier for both vision and embeddings)
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

DB_PATH=./image_relevance.db
DATA_DIR=./data

# Mismatch-guard tuning (see EVIDENCE.md / README for how these were picked
# against the labeled eval set). 0.74 was picked empirically against REAL
# gemini-embedding-001 output: the 10 true-positive matches scored
# 0.7649-0.8650 cosine similarity, the 2 off-topic posts scored 0.6999 and
# 0.7120 — 0.74 sits in that gap. (The original 0.55 was tuned against the
# mock embedder's artificially-separated vectors and does not transfer;
# real embeddings have a much higher similarity floor between unrelated
# text than the mock ones did. See EVIDENCE.md.)
SIMILARITY_THRESHOLD=0.74
MIN_CONFIDENCE=0.6

PORT=8000

# Set to 1 to use fixed, deterministic mock vision/embedding responses
# instead of real Gemini calls (useful for fast local iteration without
# burning API quota). Leave at 0 for real runs / grading.
MOCK_AI=0
